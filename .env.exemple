# ==== COMPRESSÃO DE MÍDIA ====
# Tamanho mínimo em KB para disparar compressão de imagem (arquivos menores são enviados 100% originais)
VITE_IMAGE_COMPRESS_THRESHOLD_KB=500
VITE_IMAGE_COMPRESS_QUALITY=0.85
# Limite máximo de arquivo para envio em MB
VITE_MAX_FILE_SIZE_MB=25

